{
  "name": "@mohitbhalotia/magica-contracts",
  "version": "0.11.0",
  "description": "Zod contracts shared by the Magica backend and frontend",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohitBhalotia/magica_backend.git",
    "directory": "packages/contracts"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && pnpm build"
  },
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
