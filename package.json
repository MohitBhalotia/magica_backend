{
  "name": "magica-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:coverage": "vitest run --project unit --coverage",
    "test:live": "echo \"not yet (M3)\"",
    "contracts:build": "pnpm --filter @agent-chat/contracts build",
    "contracts:publish": "pnpm contracts:build && pnpm --filter @agent-chat/contracts publish --no-git-checks",
    "openapi": "echo \"not yet (M7)\"",
    "docs:dev": "echo \"not yet (M7)\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,css}": "prettier --write"
  },
  "dependencies": {
    "@agent-chat/contracts": "workspace:*",
    "@clerk/nextjs": "7.9.15",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "next": "16.4.2",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
