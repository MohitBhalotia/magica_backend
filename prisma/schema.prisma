// Core schema v1 (DEC-038). ToolInvocation, RunSkill, Waitpoint, Attachment, Asset, ApiKey and
// webhook tables arrive as additive migrations in the milestone that uses them.

generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// id is the Clerk user id, so auth() gives us the key directly; no lookup table.
model User {
  id        String   @id
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  creditAccount CreditAccount?
  chats         Chat[]
  ledger        CreditLedger[]

  @@map("users")
}

enum TitleSource {
  placeholder // "New chat" until the first prompt arrives
  prompt // truncated first prompt
  generated // AI title from a background task
  user // renamed by the user; never overwritten

  @@map("title_source")
}

model Chat {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  title       String      @default("New chat")
  titleSource TitleSource @default(placeholder) @map("title_source")
  isPinned    Boolean     @default(false) @map("is_pinned")
  pinnedAt    DateTime?   @map("pinned_at")
  /// Soft delete; a cron hard-purges later (PRD §6.1).
  deletedAt   DateTime?   @map("deleted_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  runs     AgentRun[]
  assets   Asset[]

  /// Target of the (chatId, userId) ownership FKs on messages and runs.
  @@unique([id, userId])
  /// Sidebar list: pinned first, then most recent, with a stable cursor.
  @@index([userId, isPinned, updatedAt, id])
  @@index([userId, createdAt, id])
  /// Fast case-insensitive substring search on titles (ILIKE '%q%') via pg_trgm.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "chats_title_trgm_idx")
  @@map("chats")
}

/// Cached balance for fast reads and admission checks; CreditLedger is authoritative.
model CreditAccount {
  id                 String   @id @default(cuid())
  /// Nullable so deleting a user keeps the account row for audit (SetNull below).
  userId             String?  @unique @map("user_id")
  balanceMicro       BigInt   @default(0) @map("balance_micro")
  monthlyUploadBytes BigInt   @default(0) @map("monthly_upload_bytes")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("credit_accounts")
}

enum MessageRole {
  user
  assistant
  system
  tool

  @@map("message_role")
}

enum MessageStatus {
  pending // created, run not started
  streaming // assistant text arriving
  success
  failed
  cancelled

  @@map("message_status")
}

model Message {
  id              String        @id @default(cuid())
  chatId          String        @map("chat_id")
  userId          String        @map("user_id")
  role            MessageRole
  status          MessageStatus @default(pending)
  /// Ordered content blocks, validated by the contracts union before every write.
  contentBlocks   Json          @default("[]") @map("content_blocks")
  /// UIMessage metadata (contracts MessageMetadataSchema), e.g. thinking time.
  metadata        Json?
  /// Plain text denormalised from contentBlocks, for search and previews.
  text            String        @default("")
  /// Client-generated id: a retried POST returns the same message instead of a duplicate.
  clientMessageId String?       @map("client_message_id")
  /// The run that produced (assistant) or consumed (user) this message.
  runId           String?       @map("run_id")
  creditUsedMicro BigInt        @default(0) @map("credit_used_micro")
  tokenUsage      Json?         @map("token_usage")
  routedModel     String?       @map("routed_model")
  errorCode       String?       @map("error_code")
  errorMessage    String?       @map("error_message")
  createdAt       DateTime      @default(now()) @map("created_at")
  completedAt     DateTime?     @map("completed_at")

  /// Ownership FK: the message's user must own the chat.
  chat          Chat             @relation(fields: [chatId, userId], references: [id, userId], onDelete: Cascade)
  run           AgentRun?        @relation("RunMessages", fields: [runId], references: [id], onDelete: SetNull)
  userRuns      AgentRun[]       @relation("RunUserMessage")
  assistantRuns AgentRun[]       @relation("RunAssistantMessage")
  toolCalls     ToolInvocation[]
  assets        Asset[]

  @@unique([chatId, clientMessageId])
  /// History: newest first, `before` cursor for older pages.
  @@index([chatId, createdAt, id])
  @@map("messages")
}

/// queued → thinking → working ⇄ waiting → completed | failed | cancelled; stopping on user Stop.
enum RunStatus {
  queued
  thinking
  working
  waiting // paused on a human waitpoint
  stopping
  completed
  failed
  cancelled

  @@map("run_status")
}

/// One durable agent turn (a Trigger.dev task run).
model AgentRun {
  id                 String    @id @default(cuid())
  chatId             String    @map("chat_id")
  userId             String    @map("user_id")
  userMessageId      String    @map("user_message_id")
  assistantMessageId String    @map("assistant_message_id")
  status             RunStatus @default(queued)
  triggerRunId       String?   @map("trigger_run_id")
  /// Idempotent dispatch: the same key can never create a second run.
  dispatchKey        String    @unique @map("dispatch_key")
  attempt            Int       @default(1)
  routedModel        String?   @map("routed_model")
  turns              Int       @default(0)
  thinkingMs         Int       @default(0) @map("thinking_ms")
  startedAt          DateTime? @map("started_at")
  finishedAt         DateTime? @map("finished_at")
  errorCode          String?   @map("error_code")
  errorMessage       String?   @map("error_message")
  traceId            String    @map("trace_id")
  /// Everything needed to re-dispatch if the trigger was lost (sweeper recovery).
  dispatchPayload    Json      @map("dispatch_payload")
  createdAt          DateTime  @default(now()) @map("created_at")

  /// Ownership FK: the run's user must own the chat.
  chat             Chat             @relation(fields: [chatId, userId], references: [id, userId], onDelete: Cascade)
  userMessage      Message          @relation("RunUserMessage", fields: [userMessageId], references: [id], onDelete: Cascade)
  assistantMessage Message          @relation("RunAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: Cascade)
  messages         Message[]        @relation("RunMessages")
  ledger           CreditLedger[]
  toolCalls        ToolInvocation[]
  skills           RunSkill[]

  /// The lock behind "one active run per chat": a second active run is a unique violation.
  /// Predicate is written in Postgres' normalised form (status IN (...) is stored as = ANY), else Prisma sees drift.
  @@unique([chatId], where: raw("(status = ANY (ARRAY['queued'::run_status, 'thinking'::run_status, 'working'::run_status, 'waiting'::run_status, 'stopping'::run_status]))"), map: "agent_runs_one_active_per_chat")
  /// Stale-run sweeper: finds active runs older than a threshold.
  @@index([status, createdAt])
  @@map("agent_runs")
}

enum LedgerType {
  grant // credits added (seed grant on sign-up)
  reserve // held before work (negative)
  release // unused reserve returned (positive)
  charge // actual tool cost (negative)
  refund // money back for failed work (positive)

  @@map("ledger_type")
}

/// Append-only; the authoritative record of every credit change. Balance = SUM(amountMicro).
model CreditLedger {
  id             String     @id @default(cuid())
  /// Nullable so ledger rows survive user deletion (SetNull below).
  userId         String?    @map("user_id")
  type           LedgerType
  /// Signed microcredits: positive adds to the balance, negative takes away.
  amountMicro    BigInt     @map("amount_micro")
  runId          String?    @map("run_id")
  invocationId   String?    @map("invocation_id")
  /// Exactly-once: e.g. `charge:{invocationId}`; a retry can't charge twice.
  idempotencyKey String     @unique @map("idempotency_key")
  note           String?
  createdAt      DateTime   @default(now()) @map("created_at")

  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  // SetNull keeps the ledger row when a purged chat takes its runs with it.
  run        AgentRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  invocation ToolInvocation? @relation(fields: [invocationId], references: [id], onDelete: SetNull)

  /// /usage page: a user's ledger, newest first, cursor-paginated.
  @@index([userId, createdAt, id])
  @@map("credit_ledger")
}

/// pending → running → succeeded | failed | cancelled
enum ToolState {
  pending
  running
  succeeded
  failed
  cancelled

  @@map("tool_state")
}

/// One tool call inside a turn. The orchestrator owns these rows; tools never write chat state.
model ToolInvocation {
  id             String    @id @default(cuid())
  runId          String    @map("run_id")
  /// The assistant message the call belongs to.
  messageId      String    @map("message_id")
  /// The model's id for the call; with runId it makes a retried step reuse this row.
  toolCallId     String    @map("tool_call_id")
  toolName       String    @map("tool_name")
  /// Registry kind (skill, discovery, media, …); drives the renderer.
  kind           String
  /// Position of the call within the turn.
  ordinal        Int
  state          ToolState @default(pending)
  /// Input with secrets removed and long prompts truncated, safe to show.
  inputSanitized Json      @map("input_sanitized")
  output         Json?
  /// Set right after the Magica run is created, before waiting: a retry never creates a second run.
  magicaRunId    String?   @unique @map("magica_run_id")
  errorCode      String?   @map("error_code")
  errorMessage   String?   @map("error_message")
  attempt        Int       @default(1)
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  durationMs     Int?      @map("duration_ms")

  run     AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  message Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  assets  Asset[]
  ledger  CreditLedger[]

  @@unique([runId, toolCallId])
  @@map("tool_invocations")
}

/// A skill loaded during a run, with the hash of the content the model saw (resume re-injects it).
model RunSkill {
  id          String   @id @default(cuid())
  runId       String   @map("run_id")
  skillName   String   @map("skill_name")
  contentHash String   @map("content_hash")
  version     String
  loadedAt    DateTime @default(now()) @map("loaded_at")

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// A skill loads once per run; a repeat load returns the saved snapshot.
  @@unique([runId, skillName])
  @@map("run_skills")
}

enum AssetKind {
  image
  video

  @@map("asset_kind")
}

/// A generated media file shown inline and in the files modal.
model Asset {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  chatId       String    @map("chat_id")
  messageId    String    @map("message_id")
  invocationId String    @map("invocation_id")
  kind         AssetKind
  /// Provider URL for now; copying to R2 is decided with uploads (DEC-054).
  url          String
  mimeType     String    @map("mime_type")
  width        Int?
  height       Int?
  durationMs   Int?      @map("duration_ms")
  sizeBytes    BigInt?   @map("size_bytes")
  /// The prompt or instruction that produced it, for the files modal.
  prompt       String?
  model        String
  createdAt    DateTime  @default(now()) @map("created_at")

  /// Ownership FK: the asset's user must own the chat.
  chat       Chat           @relation(fields: [chatId, userId], references: [id, userId], onDelete: Cascade)
  message    Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  invocation ToolInvocation @relation(fields: [invocationId], references: [id], onDelete: Cascade)

  /// Files modal: a chat's assets, newest first, cursor-paginated.
  @@index([chatId, createdAt, id])
  @@map("assets")
}
