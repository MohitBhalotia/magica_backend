# Copy to .env.local. Never commit real values.
LOG_LEVEL=info

# Trigger.dev worker only (src/lib/workerEnv.ts): free key from openrouter.ai → Keys.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=

# Clerk (dashboard → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_
FRONTEND_ORIGINS=http://localhost:3000

# Upstash Redis REST (console → database → REST API). Rate-limit counters only.
UPSTASH_REDIS_URL=https://
UPSTASH_REDIS_TOKEN=

# Trigger.dev (project → API keys → Development). `pnpm trigger:dev` uses your CLI login instead.
TRIGGER_SECRET_KEY=tr_dev_
TRIGGER_PROJECT_REF=proj_

# Uploads (M5). Transloadit: Account → API credentials (this setup signs with sha256).
TRANSLOADIT_KEY=
TRANSLOADIT_SECRET=
# Cloudflare R2: a private bucket and an API token with Object Read & Write on it. Transloadit holds
# the same token as the "magica-uploads" Template Credential (host must start with https://).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Neon (dashboard → Connect). App uses the pooled host (-pooler); migrations use the direct host.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Integration tests (`pnpm test:int`) create a throwaway Neon branch (Neon → Account → API keys).
NEON_API_KEY=
NEON_PROJECT_ID=
