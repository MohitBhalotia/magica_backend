# Copy to .env.local. Never commit real values.
LOG_LEVEL=info
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=

# Clerk (dashboard → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_
FRONTEND_ORIGINS=http://localhost:3000

# Upstash Redis REST (console → database → REST API). Rate-limit counters only.
UPSTASH_REDIS_URL=https://
UPSTASH_REDIS_TOKEN=

# Trigger.dev (project → API keys → Development). `pnpm trigger:dev` uses your CLI login instead.
TRIGGER_SECRET_KEY=tr_dev_

# Neon (dashboard → Connect). App uses the pooled host (-pooler); migrations use the direct host.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
